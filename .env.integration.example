# Integration-test target. Copy the keys into .env.local and fill them from a
# DISPOSABLE Supabase project — never from the project the application runs on.
#
# The suite creates orders, payments and audit rows and does not delete them.
# `tests/integration/supabase-test-environment.ts` refuses to run when this
# target resolves to the same Supabase project or the same database identity as
# NEXT_PUBLIC_SUPABASE_URL / DATABASE_URL, so a copy of the live values will not
# start the tests — it will only produce a refusal.
#
# Preferred: a local disposable stack (`supabase start`), which needs only the
# URL and database URL on loopback addresses.
# Allowed:   a dedicated remote "… TEST" project with its own project ref.
# Forbidden: the production/application project, under any circumstances.

# Both must be set exactly as written; either one missing keeps the suite off.
RUN_SUPABASE_INTEGRATION_TESTS=
SUPABASE_INTEGRATION_TEST_CONFIRM=I_UNDERSTAND_TEMPORARY_DATA_WILL_BE_CREATED

# https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for a local stack.
SUPABASE_INTEGRATION_TEST_URL=
SUPABASE_INTEGRATION_TEST_ANON_KEY=
SUPABASE_INTEGRATION_TEST_SERVICE_ROLE_KEY=

# Required for remote targets only, and it must equal the <project-ref> above.
SUPABASE_INTEGRATION_TEST_PROJECT_REF=

# Direct or pooler URL for the same test project. For a remote target the
# hostname or pooler username must contain the project ref; for a local stack it
# must be a loopback address.
SUPABASE_INTEGRATION_TEST_DATABASE_URL=

# Real HTTP/auth/cookie E2E against an already-running disposable deployment.
# Leave empty unless such a deployment exists; see tests/integration/README.md.
RUN_SEHIR_HTTP_E2E_TESTS=
SEHIR_HTTP_E2E_CONFIRM=I_UNDERSTAND_THIS_MUTATES_A_DISPOSABLE_TEST_FIXTURE
SEHIR_HTTP_E2E_TARGET_CLASS=DISPOSABLE_TEST
SEHIR_HTTP_E2E_BASE_URL=
SEHIR_HTTP_E2E_ALLOWED_ORIGIN=
