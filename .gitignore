# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files
.env*
!.env.example
!.env.integration.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.phase7d3-fixture.json

# The local print agent's device map and journal stay on the restaurant's
# machine; the config may name LAN addresses and must never be committed.
tools/printer-agent/printer-agent.config.json
tools/printer-agent/*.journal.json

# Personal editor state, not project configuration.
.vscode/

# One-off database probes and maintenance scripts. They load the real
# DATABASE_URL through @next/env, and one of them can clear business data, so
# they must never become committable by a stray `git add -A`.
tmp-*.mjs
