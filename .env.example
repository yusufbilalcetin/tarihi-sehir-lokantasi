# Central PostgreSQL / Supabase foundation. Leave real values in .env.local and
# deployment environment variables; never commit credentials.
# For Vercel runtime use the Supabase transaction-pooler connection string.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase now calls this the publishable key. The legacy anon-key variable is
# accepted during migration, but configure only one public key in production.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and RLS-bypassing. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Independent server-only secrets, each at least 32 random bytes.
# AUTH_SECRET signs short-lived customer/table sessions.
AUTH_SECRET=
# QR_TOKEN_PEPPER HMACs raw table tokens before database lookup/storage.
QR_TOKEN_PEPPER=

# Distributed abuse-control key. The central DATABASE_URL is used as the shared
# store; local development may use the explicit development adapter without it.
RATE_LIMIT_KEY_SECRET=

# Bearer secret for the protected outbox-dispatch worker endpoint (32+ bytes).
# Configure the scheduler to POST with Authorization: Bearer <value>.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET and can only issue GET,
# so the scheduler works only when this repeats OUTBOX_DISPATCH_SECRET exactly.
CRON_SECRET=
OUTBOX_DISPATCH_SECRET=

# Bearer secret for the protected data-maintenance endpoint (32+ bytes).
# Generate it independently: it must NOT equal OUTBOX_DISPATCH_SECRET, because
# this one authorises row deletion. Never prefix it with NEXT_PUBLIC_.
MAINTENANCE_SECRET=

# Explicit opt-in required by `npm run db:seed`; development only.
ALLOW_DATABASE_SEED=false

# Structured server logging: debug | info | warn | error
LOG_LEVEL=info

# Which supplier fills in the menu's other 108 languages. Unset or "none"
# leaves automatic translation switched off: the admin button is disabled and
# the endpoint answers TRANSLATION_PROVIDER_UNAVAILABLE, while the 109-language
# manual editor and the static locale catalogs keep working. No provider is
# shipped — `bing-translate-api` is an unofficial development-only dependency
# used by `npm run generate:i18n` and is deliberately NOT a runtime provider.
# Adding a real vendor means registering it in lib/i18n/translation-provider.ts
# and giving it its own server-only credential variable there.
MENU_TRANSLATION_PROVIDER=none

# Optional: server-only ExchangeRate-API key. Never prefix this with NEXT_PUBLIC_.
EXCHANGE_RATE_API_KEY=

# Server-only staff auth. Never prefix these with NEXT_PUBLIC_ — that would ship
# them to the browser. Panels stay locked while any of them is unset.
# Generate the secret with: openssl rand -base64 48
STAFF_SESSION_SECRET=
STAFF_LOGIN_CODE=
STAFF_LOGIN_PIN=
ADMIN_LOGIN_CODE=
ADMIN_LOGIN_PIN=

# HMAC pepper for local print agent bearer tokens (32+ bytes). Its own secret:
# reusing OUTBOX_DISPATCH_SECRET or MAINTENANCE_SECRET here would let one leak
# authorise unrelated capabilities. Raw agent tokens are never stored here —
# they are shown once in the admin panel and kept on the agent machine.
PRINTER_AGENT_TOKEN_PEPPER=

# Table launcher on the home page, for development and preview only. Off
# unless this is exactly "true", and ignored entirely on a production runtime —
# VERCEL_ENV=production, or NODE_ENV=production where the platform sets no
# VERCEL_ENV at all, which is how a self-hosted server looks. Never
# NEXT_PUBLIC_.
ENABLE_DEMO_LAUNCHER=
# The same launcher on a production deployment: lets a visitor pick a table
# from the home page instead of scanning the code printed on it. Its own flag
# so a preview setting cannot open it by accident. Off unless exactly "true".
ENABLE_PRODUCTION_TABLE_PICKER=
# Which restaurant the launcher demos. Required only when more than one exists.
DEMO_RESTAURANT_SLUG=

# Origin the one-time staff password-setup link points at. The link lands on
# /staff/set-password in THIS application, never on the provider Site URL.
# Defaults to http://localhost:3000 when unset.
APP_BASE_URL=

# DEV/PREVIEW ONLY — NEVER ENABLE IN PRODUCTION.
#
# Five short credentials for demonstrating the panels: admin / mudur / garson /
# mutfak / kasa, each with the username plus "1234" as the password. They exist
# so the panels can be shown to someone without handing out a real account.
#
# The password is published, so on a live restaurant deployment these five
# usernames would be the entire front door. The code therefore refuses them in
# production outright: `isSimpleTestLoginEnabled` returns false whenever
# VERCEL_ENV is "production", or — self-hosted, where that variable does not
# exist — whenever NODE_ENV is "production". Setting this to "true" on the live
# system by accident changes nothing, and there is no second flag that opens it
# there. Vercel previews and local development still honour it.
#
# Safe default: leave unset. It changes no account's real password either way.
ENABLE_SIMPLE_TEST_LOGIN=
