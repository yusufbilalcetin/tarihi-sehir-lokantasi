{
  "name": "sehir-lokantasi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:foundation": "tsx --test tests/foundation/*.test.ts tests/foundation/*.test.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "check:session": "node scripts/check-session.mjs",
    "check:integration": "node --import tsx scripts/integration-preflight.mjs",
    "staff:bootstrap": "node --conditions=react-server --import tsx scripts/staff-bootstrap.ts",
    "staff:setup-link": "node --conditions=react-server --import tsx scripts/staff-setup-link.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "generate:i18n": "node scripts/generate-menu-locales.mjs",
    "generate:i18n:missing": "node scripts/generate-menu-locales.mjs --missing-ui",
    "validate:i18n": "node scripts/validate-menu-i18n.mjs",
    "printer-agent": "tsx tools/printer-agent/src/index.ts",
    "printer-agent:typecheck": "tsc --noEmit -p tools/printer-agent/tsconfig.json",
    "test:printer-agent": "tsx --test tests/agent/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode-generator": "^1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bing-translate-api": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
